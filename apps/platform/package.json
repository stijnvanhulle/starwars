{
  "name": "@stijnvanhulle/platform",
  "version": "0.0.0",
  "private": true,
  "description": "Starwars team builder platform",
  "license": "MIT",
  "author": "Stijn Van Hulle <stijn@stijnvanhulle.be>",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint -c ../../oxlint.config.ts --disable-nested-config ./src",
    "pretypecheck": "next typegen",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "test": "vitest run --config ./vitest.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "playwright:install": "playwright install --with-deps chromium",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "9.0.1",
    "@mui/material-nextjs": "9.0.1",
    "@stijnvanhulle/components": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "msw": "^2.14.6",
    "tsx": "^4.22.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
