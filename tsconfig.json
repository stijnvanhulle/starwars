{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./configs/bundler.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": ["bun-types"],
    "paths": {
      "@whale/components": ["./packages/components/src/index.ts"]
    }
  },
  "include": ["./package.json", "./tsdown.config.ts", "./vitest.config.ts", "./src/**/*"],
  "exclude": ["node_modules", "dist", "tmp", "coverage", "**/__snapshots__/**"]
}
