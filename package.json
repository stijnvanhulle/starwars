{
  "name": "@whale/template",
  "version": "0.0.0",
  "private": true,
  "description": "Modern TypeScript monorepo template with pnpm, Turborepo, oxlint, oxfmt, tsdown, Vitest and Changesets",
  "repository": {
    "type": "git",
    "url": "https://github.com/stijnvanhulle/template.git"
  },
  "license": "MIT",
  "author": "Stijn Van Hulle <stijn@stijnvanhulle.be>",
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "internals/*"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "oxfmt -c oxfmt.config.ts apps packages internals configs",
    "gen": "turbo run gen",
    "graph": "npx nx graph ",
    "lint": "oxlint -c oxlint.config.ts --disable-nested-config ./apps ./packages",
    "lint:fix": "oxlint -c oxlint.config.ts --disable-nested-config --fix ./apps ./packages",
    "lint:spell": "cspell \"**/*.{ts,md}\" --config ./cspell.json --no-progress",
    "release": "changeset publish",
    "release:canary": "changeset publish --no-git-tag",
    "start": "turbo run start",
    "test": "vitest run",
    "test:bench": "NODE_OPTIONS='--max_old_space_size=4096' vitest bench --config ./configs/vitest.bench.config.ts",
    "test:watch": "vitest",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck --continue",
    "upgrade": "npx taze -r -w --exclude pnpm --maturity-period 3",
    "version": "changeset version",
    "version:canary": "changeset version --snapshot canary"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@size-limit/file": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "bun-types": "^1.3.14",
    "cspell": "^10.0.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "size-limit": "catalog:",
    "taze": "^19.13.0",
    "ts-node": "^10.9.2",
    "tsdown": "catalog:",
    "turbo": "^2.9.14",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.0.0"
  },
  "namespace": "@whale"
}
