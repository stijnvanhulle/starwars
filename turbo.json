{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "gen"],
      "outputs": ["dist/**", "*.d.ts", "*.d.cts", ".output/**", ".next/**", "!.next/cache/**"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "tsdown.config.ts", "next.config.ts", "package.json", "tsconfig.json"]
    },
    "gen": {
      "inputs": ["openapi/**", "kubb.config.ts", "package.json"],
      "outputs": ["src/gen/api/**", "src/gen/starwars/**"]
    },
    "typecheck": {
      "dependsOn": ["gen"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "tsconfig.json"],
      "outputs": [],
      "cache": false
    },
    "clean": {
      "dependsOn": ["^clean"],
      "outputs": [],
      "cache": false,
      "outputLogs": "new-only"
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "inputs": ["src/**", "next.config.ts", "package.json", "tsconfig.json"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "lint": {
      "dependsOn": ["gen"],
      "outputs": [],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "package.json"],
      "cache": false
    },
    "lint:fix": {
      "dependsOn": ["gen"],
      "outputs": ["src/**"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "package.json"],
      "cache": false,
      "outputLogs": "new-only"
    },
    "test": {
      "dependsOn": ["gen"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "release": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "release:canary": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
